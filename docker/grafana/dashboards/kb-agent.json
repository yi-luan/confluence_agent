{
  "uid": "kb-agent",
  "title": "Knowledge Agent",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "llm",
    "rag"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "每分鐘提問數",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kb_http_requests_total{path=\"/api/v1/ask\"}[5m]))*60"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "/ask p95 延遲",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kb_http_request_duration_seconds_bucket{path=\"/api/v1/ask\"}[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "近 1 小時 Token 用量",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kb_llm_tokens_total[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "拒答比例（找不到文件）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kb_no_answer_total[1h])) / clamp_min(sum(rate(kb_agent_route_total{route=\"knowledge\"}[1h])),1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 延遲 p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kb_http_request_duration_seconds_bucket{path=\"/api/v1/ask\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kb_http_request_duration_seconds_bucket{path=\"/api/v1/ask\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM 單次呼叫延遲 p95（依模型）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(kb_llm_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token 用量 / 分鐘（依模型、類型）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, type) (rate(kb_llm_tokens_total[5m]))*60",
          "legendFormat": "{{model}} {{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent 路由分佈",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(kb_agent_route_total[5m]))*60",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "錯誤率（5xx / LLM 失敗）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kb_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(kb_http_requests_total[5m])),1e-9)",
          "legendFormat": "HTTP 5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(kb_llm_calls_total{status=\"error\"}[5m])) / clamp_min(sum(rate(kb_llm_calls_total[5m])),1e-9)",
          "legendFormat": "LLM error"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "檢索最高相似度 p50（越低越可能答不出來）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kb_retrieval_top_score_bucket[15m])))",
          "legendFormat": "top score p50"
        }
      ]
    }
  ]
}