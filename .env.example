# 複製成 .env 後修改。真正的 .env 已列入 .gitignore，不會進版控。

ADMIN_API_KEY=change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kb

# ---- 選一種 LLM provider：openai | azure | gemini | ollama ----
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434

# Gemini 範例
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIM=3072
# GOOGLE_API_KEY=

# OpenAI 範例
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# OPENAI_API_KEY=

# Azure OpenAI 範例
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Confluence（選用）----
# Cloud：CONFLUENCE_USER 填 email、TOKEN 填 API token
# Server / Data Center：USER 留空、TOKEN 填 Personal Access Token
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACES=
